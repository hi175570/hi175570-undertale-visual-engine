/// Diagnostic-only test source, not a game resource. Inject into an isolated
/// build of BattleEditor_Core and call before world initialization. No save IO.
function BattleEditor_WorkspaceRegressionCheck(condition,label) {
    if(!condition) throw "WORKSPACE_REGRESSION_FAIL: "+label;
    show_debug_message("WORKSPACE_CHECK: "+label);
}

function BattleEditor_WorkspaceRegression() {
    var project=BattleEditor_NewProject();
    var view_state={tab:0,workspace_open:false,script_selected_list:0,script_selected_step:1,script_pan_x:24,script_pan_y:-90,script_zoom:0.8};
    BattleEditor_WorkspaceSetOpen(view_state,true);
    BattleEditor_WorkspaceRegressionCheck(view_state.tab==2&&view_state.workspace_open,"script entry opens immersive workspace");
    BattleEditor_WorkspaceEscape(view_state);
    BattleEditor_WorkspaceRegressionCheck(view_state.tab==2&&!view_state.workspace_open,"Escape shelves workspace without changing logical tab");
    BattleEditor_WorkspaceEscape(view_state);
    BattleEditor_WorkspaceRegressionCheck(view_state.workspace_open&&view_state.script_selected_step==1&&view_state.script_pan_y==-90&&view_state.script_zoom==0.8,"second Escape restores selection and view");
    view_state.script_dropdown="kind";BattleEditor_WorkspaceEscape(view_state);
    BattleEditor_WorkspaceRegressionCheck(view_state.workspace_open&&view_state.script_dropdown=="","Escape dismisses dropdown before workspace");
    view_state.tab=1;
    BattleEditor_WorkspaceRegressionCheck(!BattleEditor_WorkspaceEscape(view_state)&&view_state.tab==1,"other tabs do not reopen workspace on Escape");
    var palette={project:project,script_dropdown:"",script_context_open:false,script_palette_open:true,script_palette_progress:1,script_palette_category:1,script_palette_scroll:0,script_zoom:1,script_stack_drag:undefined};
    BattleEditor_WorkspaceNewPaletteInput(palette,580,18,true,0);
    BattleEditor_WorkspaceRegressionCheck(palette.script_dropdown=="formula_help","top-right formula button opens help without a selected list");
    BattleEditor_WorkspaceNewPaletteInput(palette,580,18,true,0);
    BattleEditor_WorkspaceRegressionCheck(palette.script_dropdown=="","same formula button closes help");
    BattleEditor_WorkspaceNewPaletteInput(palette,50,436,true,0);
    BattleEditor_WorkspaceRegressionCheck(is_undefined(palette.script_stack_drag),"palette footer cannot select hidden row");
    BattleEditor_WorkspaceNewPaletteInput(palette,50,110,true,0);
    BattleEditor_WorkspaceRegressionCheck(palette.script_stack_drag.mode=="new"&&palette.script_stack_drag.kind=="control_object"&&array_length(project.script_lists)==0,"palette starts drag without creating live data");
    palette.script_palette_category=0;
    BattleEditor_WorkspaceNewPaletteInput(palette,50,140,true,0);
    BattleEditor_WorkspaceRegressionCheck(palette.script_stack_drag.mode=="head"&&palette.script_stack_drag.entry_kind==BATTLE_EDITOR_SCRIPT_ENTRY.MONSTER_TURN,"separate event-head palette drag");
    var drag={mode:"new",source_uid:-1,first:0,kind:"wait",entry_kind:-1,snap:{list_uid:-1,index:0}};
    var loose_uid=BattleEditor_WorkspaceCommitDrop(project,drag,200,100,1);
    var loose=BattleEditor_FindScriptList(project,loose_uid);
    var first_uid=loose.steps[0].uid;
    loose.steps[0].duration=137;
    BattleEditor_WorkspaceRegressionCheck(!BattleEditor_WorkspaceHasHeader(loose),"blank drop is orphan");
    BattleEditor_WorkspaceRegressionCheck(BattleEditor_WorkspaceHeaderHeight(loose)==0,"orphan has no header");
    BattleEditor_WorkspaceRegressionCheck(BattleEditor_WorkspaceHeight(loose)==48,"one orphan row height");
    var runtime={project:project,script_runtime_states:[]};
    BattleEditor_WorkspaceRegressionCheck(!BattleEditor_RuntimeStartList(runtime,loose_uid),"manual run rejects orphan before runtime initialization");
    BattleEditor_WorkspaceRegressionCheck(!BattleEditor_StartScriptList(runtime,loose_uid),"node start rejects orphan");
    BattleEditor_WorkspaceRegressionCheck(!BattleEditor_ScriptListBelongsToTurn(loose,1),"automatic turn ignores orphan");
    BattleEditor_WorkspaceRegressionCheck(BattleEditor_ScriptListDuration(project,loose,[])==0,"orphan contributes no duration");
    var stored=json_parse(json_stringify(BattleEditor_ProjectSparseForStorage(project)));
    stored=BattleEditor_ProjectNormalize(stored);
    var restored=BattleEditor_FindScriptList(stored,loose_uid);
    BattleEditor_WorkspaceRegressionCheck(!BattleEditor_WorkspaceHasHeader(restored)&&restored.steps[0].uid==first_uid&&restored.steps[0].duration==137,"sparse save and normalized load retain orphan identity and values");
    var before_preview=json_stringify(project);
    drag.mode="head";drag.entry_kind=BATTLE_EDITOR_SCRIPT_ENTRY.MONSTER_TURN;
    drag.snap=BattleEditor_WorkspaceSnap(project,drag,200,66,1);
    BattleEditor_WorkspaceRegressionCheck(drag.snap.list_uid==loose_uid,"header snaps above orphan");
    BattleEditor_WorkspaceRegressionCheck(json_stringify(project)==before_preview,"preview and cancellation do not mutate project");
    var attached_uid=BattleEditor_WorkspaceCommitDrop(project,drag,200,66,2);
    BattleEditor_WorkspaceRegressionCheck(attached_uid==loose_uid&&loose.steps[0].uid==first_uid,"header attachment preserves list and step identity");
    BattleEditor_WorkspaceRegressionCheck(loose.entry_value==2&&loose.world_y==66&&BattleEditor_WorkspaceHeaderHeight(loose)==34,"header adopts current turn and correct geometry");
    BattleEditor_WorkspaceRegressionCheck(BattleEditor_StartScriptList(runtime,loose_uid)&&array_length(runtime.script_runtime_states)==1,"attached stack uses existing runtime");
    var step_b=BattleEditor_NewScriptStep(project,"wait"),step_c=BattleEditor_NewScriptStep(project,"wait");
    step_b.duration=45;step_c.duration=61;
    array_push(loose.steps,step_b,step_c);
    var base_state=BattleEditor_ProjectSparseForStorage(project);
    drag={mode:"tail",source_uid:loose_uid,first:1,kind:"",entry_kind:-1,snap:{list_uid:-1,index:0}};
    var suffix_uid=BattleEditor_WorkspaceCommitDrop(project,drag,480,200,2);
    var suffix=BattleEditor_FindScriptList(project,suffix_uid);
    BattleEditor_WorkspaceRegressionCheck(array_length(loose.steps)==1&&array_length(suffix.steps)==2,"middle split detaches complete suffix");
    BattleEditor_WorkspaceRegressionCheck(suffix.steps[0].uid==step_b.uid&&suffix.steps[1].uid==step_c.uid&&suffix.steps[1].duration==61,"split preserves order UID and parameters");
    BattleEditor_WorkspaceRegressionCheck(!BattleEditor_WorkspaceHasHeader(suffix)&&BattleEditor_WorkspaceHasHeader(loose),"split does not invent event head");
    var after_state=BattleEditor_ProjectSparseForStorage(project),ops=[];
    BattleEditor_StorageCollectChanges(base_state,after_state,[],ops);
    var replay=BattleEditor_StorageClone(base_state);
    for(var op=0;op<array_length(ops);op++) BattleEditor_StorageApplyOperation(replay,ops[op]);
    BattleEditor_WorkspaceRegressionCheck(BattleEditor_StorageValueEqual(replay,after_state),"existing incremental journal replays split without losing data");
    drag.source_uid=suffix_uid;drag.first=0;drag.snap={list_uid:loose_uid,index:1};
    BattleEditor_WorkspaceCommitDrop(project,drag,200,148,2);
    BattleEditor_WorkspaceRegressionCheck(array_length(project.script_lists)==1&&array_length(loose.steps)==3,"join consumes empty orphan container only");
    BattleEditor_WorkspaceRegressionCheck(loose.steps[1].uid==step_b.uid&&loose.steps[2].uid==step_c.uid,"join preserves unique steps");
    drag.source_uid=loose_uid;drag.first=2;drag.snap={list_uid:loose_uid,index:0};
    BattleEditor_WorkspaceCommitDrop(project,drag,200,100,2);
    BattleEditor_WorkspaceRegressionCheck(loose.steps[0].uid==step_c.uid&&loose.steps[1].uid==first_uid&&loose.steps[2].uid==step_b.uid,"same-stack suffix reorder");
    var unchanged=json_stringify(project);
    drag.first=1;drag.snap.index=2;
    BattleEditor_WorkspaceRegressionCheck(BattleEditor_WorkspaceCommitDrop(project,drag,0,0,2)==-1&&json_stringify(project)==unchanged,"invalid self drop is atomic");
    var loop=BattleEditor_NewScriptStep(project,"repeat");loop.repeat_length=2;
    var loop_list=BattleEditor_NewScriptList(project,0,0);
    loop_list.steps=[loop,BattleEditor_NewScriptStep(project,"wait"),BattleEditor_NewScriptStep(project,"wait"),BattleEditor_NewScriptStep(project,"wait")];
    BattleEditor_WorkspaceSpliceSteps(loop_list,2,0,[BattleEditor_NewScriptStep(project,"wait")]);
    BattleEditor_WorkspaceRegressionCheck(loop.repeat_length==3,"inserting in loop expands span");
    BattleEditor_WorkspaceSpliceSteps(loop_list,2,2,[]);
    BattleEditor_WorkspaceRegressionCheck(loop.repeat_length==1,"removing loop members shrinks span");
    BattleEditor_WorkspaceSpliceSteps(loop_list,3,0,[BattleEditor_NewScriptStep(project,"wait")]);
    BattleEditor_WorkspaceRegressionCheck(loop.repeat_length==1,"insertion outside loop does not change span");
    var view={script_layout_revision:1,script_layout_cache:{}};
    var ranges=BattleEditor_WorkspaceRepeatRanges(view,loop_list);
    BattleEditor_WorkspaceRegressionCheck(array_length(ranges)==1&&ranges[0].first==0&&ranges[0].last==2,"loop outline encloses header and body once");
    var edge_runs=view.script_layout_cache[$ "u_"+string(loop_list.uid)].edge_runs;
    BattleEditor_WorkspaceRegressionCheck(array_length(edge_runs)==2&&edge_runs[0].in_repeat&&edge_runs[0].first==0&&edge_runs[0].last==2&&!edge_runs[1].in_repeat,"original perimeter has cached loop and normal edge runs");
    loop.enabled=false;view.script_layout_revision+=1;
    BattleEditor_WorkspaceRegressionCheck(array_length(BattleEditor_WorkspaceRepeatRanges(view,loop_list))==0,"disabled loop clears cached outline on edit");
    edge_runs=view.script_layout_cache[$ "u_"+string(loop_list.uid)].edge_runs;
    BattleEditor_WorkspaceRegressionCheck(array_length(edge_runs)==1&&!edge_runs[0].in_repeat,"disabled loop restores original border color");
    var second=BattleEditor_NewScriptList(project,500,300);array_push(project.script_lists,second);
    var link=BattleEditor_NewScriptStep(project,"start_list");link.target_list_uid=loose_uid;array_push(second.steps,link);
    drag={mode:"list",source_uid:loose_uid,first:0,snap:{list_uid:-1,index:0}};
    BattleEditor_WorkspaceCommitDrop(project,drag,-100,700,2);
    BattleEditor_WorkspaceRegressionCheck(link.target_list_uid==loose.uid&&loose.world_x==-100&&loose.world_y==700,"moving headed stack retains node connections and unrestricted world coordinates");
    var roundtrip=BattleEditor_ProjectNormalize(json_parse(json_stringify(BattleEditor_ProjectSparseForStorage(project))));
    BattleEditor_WorkspaceRegressionCheck(BattleEditor_FindScriptList(roundtrip,second.uid).steps[0].target_list_uid==loose_uid,"node connections survive save and load");
    var seen={};
    var drag_probe={mode:"tail",source_uid:second.uid,first:0,active:true};
    var unchanged=json_stringify(second);
    BattleEditor_WorkspaceRegressionCheck(BattleEditor_WorkspaceVisibleCount(second,drag_probe)==0,"drag hides moving suffix but leaves event head");
    drag_probe.mode="list";
    BattleEditor_WorkspaceRegressionCheck(BattleEditor_WorkspaceVisibleCount(second,drag_probe)==-1,"whole-stack drag hides original silhouette");
    drag_probe.active=false;
    BattleEditor_WorkspaceRegressionCheck(BattleEditor_WorkspaceVisibleCount(second,drag_probe)==array_length(second.steps),"click before drag threshold keeps original visible");
    BattleEditor_WorkspaceRegressionCheck(BattleEditor_WorkspaceVisibleCount(second,undefined)==array_length(second.steps)&&json_stringify(second)==unchanged,"cancel restores source without modifying its data");
    var split_probe={uid:991,entry_kind:1,steps:[{}, {}, {}]};
    BattleEditor_WorkspaceRegressionCheck(BattleEditor_WorkspaceVisibleCount(split_probe,{mode:"tail",source_uid:991,first:1,active:true})==1,"middle split renders only stationary prefix");
    split_probe.entry_kind=-1;
    BattleEditor_WorkspaceRegressionCheck(BattleEditor_WorkspaceVisibleCount(split_probe,{mode:"tail",source_uid:991,first:0,active:true})==-1,"taking all orphan blocks hides empty source");
    var scaled=Window_ScaleSize(2,640,480,1920,1080);
    BattleEditor_WorkspaceRegressionCheck(scaled.width==1280&&scaled.height==960,"200 percent preserves 4:3 at 1280x960");
    scaled=Window_ScaleSize(1.5,640,480,1920,1080);
    BattleEditor_WorkspaceRegressionCheck(scaled.width==960&&scaled.height==720,"150 percent scales both axes equally");
    scaled=Window_ScaleSize(0,640,480,1366,768);
    BattleEditor_WorkspaceRegressionCheck(scaled.width<=1326&&scaled.height<=688&&abs(scaled.width/scaled.height-4/3)<0.002,"fit leaves room for window chrome and taskbar");
    global.window_scale=2;Window_ApplyScale();
    scaled=Window_ScaleSize(2,640,480,display_get_width(),display_get_height());
    BattleEditor_WorkspaceRegressionCheck(abs(window_get_width()-scaled.width)<=1&&abs(window_get_height()-scaled.height)<=1,"Runner applies window scale");
    Border_SetEnabled(false,false);
    BattleEditor_WorkspaceRegressionCheck(abs(window_get_width()-scaled.width)<=1,"border reset retains selected window scale");
    for(var li=0;li<array_length(roundtrip.script_lists);li++) for(var si=0;si<array_length(roundtrip.script_lists[li].steps);si++){
        var key="u_"+string(roundtrip.script_lists[li].steps[si].uid);
        BattleEditor_WorkspaceRegressionCheck(!struct_exists(seen,key),"step UID remains unique "+key);seen[$ key]=true;
    }
    show_debug_message("WORKSPACE_REGRESSION_PASS");
}
