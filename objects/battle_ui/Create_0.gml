depth=DEPTH_BATTLE.UI;
x=30;
y=401;
name_offset_x=0;
name_offset_y=0;
lv_offset_x=0;
lv_offset_y=0;
vitals_offset_x=0;
vitals_offset_y=0;
show_hp_label=true;
show_bar=true;
show_kr=true;
show_numbers=true;
show_shield=true;
show_overhead=false;
purple_drop_active=false;
purple_drop_x=0;
purple_drop_y=0;
purple_drop_width=0;
purple_drop_height=20;
purple_drop_vx=0;
purple_drop_vy=0;
purple_drop_gravity=0.16;
purple_drop_angle=0;
purple_drop_spin=0;
purple_drop_age=0;
purple_drop_alpha=1;
heal_tween_active=false;
heal_tween_age=0;
heal_tween_duration=18;
heal_tween_start_hp=Player_GetHp();
heal_tween_target_hp=heal_tween_start_hp;
heal_tween_start_purple=Player_GetPurpleOccupancy();
heal_tween_target_purple=heal_tween_start_purple;
if(variable_global_exists("battle_editor_project_runtime")){
    var editor_layout=global.battle_editor_project_runtime.initialization;
    if(struct_exists(editor_layout,"hud_x")) x=editor_layout.hud_x;
    if(struct_exists(editor_layout,"hud_y")) y=editor_layout.hud_y;
    if(struct_exists(editor_layout,"hud_show_hp_label")) show_hp_label=editor_layout.hud_show_hp_label;
    if(struct_exists(editor_layout,"hud_show_bar")) show_bar=editor_layout.hud_show_bar;
    if(struct_exists(editor_layout,"hud_show_kr")) show_kr=editor_layout.hud_show_kr;
    if(struct_exists(editor_layout,"hud_show_numbers")) show_numbers=editor_layout.hud_show_numbers;
    if(struct_exists(editor_layout,"hud_show_shield")) show_shield=editor_layout.hud_show_shield;
    if(struct_exists(editor_layout,"hud_show_overhead")) show_overhead=editor_layout.hud_show_overhead;
}
var overhead_instance=instance_create_depth(0,0,(DEPTH_BATTLE.SOUL+DEPTH_BATTLE.BEAM)*0.5,battle_ui_overhead);
overhead_instance.owner=id;
